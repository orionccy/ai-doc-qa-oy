[{"id": "1786078913.1021254-0-2378f9", "doc_name": "fde-test.md", "text": "# FDE 岗位介绍手册\n\nFDE 全称 Field Development Engineer,即现场开发工程师,常见于微软、AWS 等大型云厂商。\n\n## 岗位职责\n1. 驻场或定期前往客户现场,帮助客户基于云平台开发落地 AI 应用。\n2. 负责技术方案设计、POC 原型搭建与演示。\n3. 对接客户需求,解决开发过程中的技术难题。\n\n## 能力要求\n- 技术广度优先于深度,需要了解大模型 API、向量数据库、前后端开发。\n- 较强的沟通表达能力和快速落地能力。\n- 能独立完成演示 demo 的开发。\n\n## 薪资水平\n国内一线城市 FDE 岗位年薪一般在 25-45 万之间,外企会更高。", "embedding": [-0.10186847299337387, -0.04931360110640526, -0.04846469685435295, -0.06146836280822754, -0.054059743881225586, -0.0003436613769736141, 0.0074616726487874985, 0.05907599627971649, 0.026489660143852234, 0.037834104150533676, -0.016080942004919052, -0.0074616726487874985, -0.020682387053966522, 0.04016859084367752, 0.048850562423467636, -0.016379987820982933, 0.026991285383701324, 0.0008669913513585925, 0.0075822556391358376, -0.03220047056674957, 0.018830232322216034, -0.015588962472975254, 0.024811146780848503, -0.01729641668498516, 0.052554868161678314, 0.010601652786135674, -0.05182172730565071, -0.02751220390200615, 0.040052831172943115, -0.06521125882863998, 0.02841898798942566, 0.0035499618388712406, 0.05571896582841873, -0.05996348708868027, -0.0628574788570404, 0.027126338332891464, 0.05050978437066078, 0.011064690537750721, -0.10086522251367569, -0.01237663347274065, 0.025988036766648293, -0.0018304490949958563, 0.0020040886010974646, 0.015588962472975254, 0.0016182231483981013, -0.06251019984483719, -0.06119825690984726, -0.0320461243391037, -0.06652320176362991, -0.007577432319521904, -0.020412281155586243, -0.08303824067115784, 0.007215683348476887, 0.0002544300223235041, 0.010630592703819275, 0.02253453992307186, -0.03385968878865242, -0.06254878640174866, -0.06467104703187943, 0.004726851359009743, -0.07011174410581589, 0.04599515721201897, 0.010891051031649113, -0.03825855627655983, 0.037506118416786194, 0.0012492393143475056, 0.015521435998380184, -0.03532597795128822, -0.026991285383701324, -0.027164924889802933, -0.029267892241477966, -0.03409120813012